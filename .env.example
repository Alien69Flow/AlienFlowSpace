# Variables de entorno de AlienFlowSpace.

# --- DOS MUNDOS DISTINTOS ---
# 1. Variables `VITE_*`: se compilan DENTRO del bundle y las ve cualquiera. Nunca pongas aquí
#    una clave de API.
# 2. Variables del servidor (sin prefijo): viven solo en la función /api/newsletter, en Vercel
#    (Settings → Environment Variables). Son las que llevan secretos.

# Copia este archivo a `.env` para desarrollo y rellena lo que necesites.

# --- Supabase (opcional: el módulo src/integrations/supabase/client.ts solo falla si se importa) ---
# URL del proyecto, p. ej. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=
# Clave publicable (anon/publishable). NUNCA la service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Newsletter: lado navegador ---
# Déjalo vacío en producción: el formulario usa /api/newsletter del mismo origen.
# Solo rellénalo si quieres apuntar a otro colector externo (Formspree, Buttondown...).
VITE_NEWSLETTER_ENDPOINT=
# Dirección de destino para el modo reserva y para los avisos de error.
VITE_CONTACT_EMAIL=info@alienflow.space

# --- Newsletter: lado servidor (Vercel, nunca en el navegador) ---
# Brevo → SMTP & API → API Keys. Sin esta clave /api/newsletter responde 503 y el
# formulario cae al modo reserva (mailto): preferimos no guardar nada a mentir.
BREVO_API_KEY=
# Id numérico de la lista destino (Brevo → Contacts → Lists).
BREVO_LIST_ID=
# Opcional: id de la plantilla de doble opt-in. Si está, el alta exige que el visitante
# confirme por correo (recomendado en la UE). Si no, el contacto se añade directamente.
BREVO_DOI_TEMPLATE_ID=
# Solo pruebas locales: base de la API del proveedor.
BREVO_API_BASE=
