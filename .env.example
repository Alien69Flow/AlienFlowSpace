# Variables de entorno de AlienFlowSpace (Vite: solo las VITE_* llegan al navegador).
# Copia este archivo a .env y rellena los valores.

# --- Supabase (opcional: el módulo src/integrations/supabase/client.ts solo falla si se importa) ---
# URL del proyecto, p. ej. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=
# Clave publicable (anon/publishable). NUNCA la service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Newsletter (necesario para que el formulario guarde direcciones de verdad) ---
# URL del formulario de tu proveedor de listas: Brevo, Mailchimp, Formspree, Buttondown...
# El formulario solo muestra "éxito" si esta URL responde 2xx.
# Si la dejas vacía, el formulario abre la app de correo del visitante (modo reserva):
# no se pierde el contacto, pero tampoco se guarda solo.
VITE_NEWSLETTER_ENDPOINT=
# Dirección de destino para el modo reserva y para los avisos de error.
VITE_CONTACT_EMAIL=info@alienflow.space
